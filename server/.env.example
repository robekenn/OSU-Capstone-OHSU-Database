DATABASE_URL=postgres://YOUR_USER:YOUR_PASSWORD@localhost:5432/ohsu_sim
PORT=3000
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_SUPABASE_KEY
# Case attachments (#63). Server only: never put the secret key in client/.env,
# a commit, or a log. Without it, attachment routes answer 503 and the rest works.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
# Optional; defaults to case-files. Create it with: npm run storage:setup --workspace server
SUPABASE_STORAGE_BUCKET=case-files
